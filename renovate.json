{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":rebaseStalePrs"
  ],
  "pinDigests": true,
  "terraform": {},
  "pre-commit": {
    "enabled": true
  },
  "argocd": {
    "managerFilePatterns": [
      "/gitops/apps/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["ACTIONLINT_VERSION: (?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["dagandersen/argocd-diff-preview:(?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "depNameTemplate": "dagandersen/argocd-diff-preview",
      "datasourceTemplate": "docker"
    }
  ],
  "timezone": "America/Sao_Paulo",
  "schedule": [
    "after 12am and before 6am every weekday"
  ],
  "prHourlyLimit": 3,
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["github-actions", "custom.regex"],
      "semanticCommitType": "ci"
    },
    {
      "matchDepNames": ["https://github.com/guarnz/oke-homelab"],
      "enabled": false
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks",
      "pinDigests": false
    },
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["provider"],
      "groupName": "terraform providers"
    },
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["module"],
      "groupName": "terraform modules"
    },
    {
      "matchManagers": ["argocd"],
      "matchFileNames": ["gitops/apps/**"],
      "groupName": "{{replace '\\.yaml$' '' (replace '^gitops/apps/' '' packageFile)}}",
      "commitMessageTopic": "{{replace '\\.yaml$' '' (replace '^gitops/apps/' '' packageFile)}}"
    }
  ]
}
